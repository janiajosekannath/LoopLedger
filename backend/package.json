{
  "name": "loopledger-backend",
  "version": "1.0.0",
  "description": "LoopLedger Subscription Management Backend",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed": "node scripts/seed.js",
    "seed:bulk": "node scripts/seedBulk.js",
    "benchmark": "node scripts/benchmark.js",
    "test": "jest --forceExit --detectOpenHandles --runInBand"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.4.1",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.13",
    "pdfkit": "^0.15.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.0.0",
    "nodemon": "^3.1.3",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 60000,
    "forceExit": true,
    "detectOpenHandles": true
  },
  "allowScripts": {
    "bcrypt@5.1.1": true,
    "mongodb-memory-server@10.4.3": true
  }
}
